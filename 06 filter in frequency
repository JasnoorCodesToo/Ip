clc;clear;close all;
% 1. Read image
X = imread('image.jpg');
% 2. Convert to grayscale
X = rgb2gray(X);
X = double(X);
% 3. Calculate 2D Fourier Transform
F = fft2(X);
Fshift = fftshift(F);
% 4. Calculate magnitude and phase
Mag = abs(Fshift);
Phase = angle(Fshift);
% 5. Swap magnitude and phase
F_mag = Mag .* exp(1i * zeros(size(Phase)));
F_phase = ones(size(Mag)) .* exp(1i * Phase);
% Reconstruct images
I_mag = real(ifft2(ifftshift(F_mag)));
I_phase = real(ifft2(ifftshift(F_phase)));

% 6. Butterworth filter parameters
[M,N] = size(X);
[u,v] = meshgrid(-floor(N/2):ceil(N/2)-1, ...
                 -floor(M/2):ceil(M/2)-1);
D = sqrt(u.^2 + v.^2);
D0 = 30;     % Cut-off frequency
n = 2;       % Filter order
% 7. Butterworth Low Pass Filter
LPF = 1 ./ (1 + (D./D0).^(2*n));
% 8. Butterworth High Pass Filter
HPF = 1 - LPF;
% 9. Apply filters
FL = Fshift .* LPF;
FH = Fshift .* HPF;
% 10. Reconstruct filtered images
IL = real(ifft2(ifftshift(FL)));
IH = real(ifft2(ifftshift(FH)));
% 11. Display all results
figure;

subplot(2,3,1);
imshow(X,[]);
title('Original Grayscale Image');

subplot(2,3,2);
imshow(log(1+Mag),[]);
title('Magnitude Spectrum');

subplot(2,3,3);
imshow(Phase,[]);
title('Phase Spectrum');

subplot(2,3,4);
imshow(I_mag,[]);
title('Magnitude Only');

subplot(2,3,5);
imshow(I_phase,[]);
title('Phase Only');

subplot(2,3,6);
imshow(IL,[]);
title('Butterworth Low Pass');

figure;

subplot(1,2,1);
imshow(IH,[]);
title('Butterworth High Pass');

subplot(1,2,2);
imshow(log(1+abs(Fshift)),[]);
title('Original Frequency Spectrum');
