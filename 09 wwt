clc;clear;close all;
X = imread('image.jpg');
X=rgb2gray(X);
% Select wavelet
wv = 'bior3.7';
% Wavelet decomposition
[cA,cH,cV,cD] = dwt2(X,wv);
% Original image size
s = size(X);
% Reconstruct individual components
A = idwt2(cA,[],[],[],wv,s);
H = idwt2([],cH,[],[],wv,s);
V = idwt2([],[],cV,[],wv,s);
D = idwt2([],[],[],cD,wv,s);
% Reconstruct complete image
Xrec = idwt2(cA,cH,cV,cD,wv,s);
% Calculate reconstruction error
err = double(X) - Xrec;
fprintf('Maximum Error = %g\n',max(abs(err(:))));

% Three-level Haar decomposition
[cA1,cH1,cV1,cD1] = dwt2(X,'haar');
[cA2,cH2,cV2,cD2] = dwt2(cA1,'haar');
[cA3,cH3,cV3,cD3] = dwt2(cA2,'haar');

% DISPLAY ALL RESULTS AT THE END

figure;

subplot(2,3,1);
imshow(X,[]);
title('Original Image');

subplot(2,3,2);
imshow(A,[]);
title('Approximation');

subplot(2,3,3);
imshow(H,[]);
title('Horizontal Detail');

subplot(2,3,4);
imshow(V,[]);
title('Vertical Detail');

subplot(2,3,5);
imshow(D,[]);
title('Diagonal Detail');

subplot(2,3,6);
imshow(Xrec,[]);
title('Reconstructed Image');

% Three-level approximation
figure;

subplot(2,2,1);
imshow(X,[]);
title('Original Image');

subplot(2,2,2);
imshow(cA1,[]);
title('Level 1');

subplot(2,2,3);
imshow(cA2,[]);
title('Level 2');

subplot(2,2,4);
imshow(cA3,[]);
title('Level 3');

% Level 3 details
figure;

subplot(1,3,1);
imshow(cH3,[]);
title('Horizontal Detail');

subplot(1,3,2);
imshow(cV3,[]);
title('Vertical Detail');

subplot(1,3,3);
imshow(cD3,[]);
title('Diagonal Detail');



