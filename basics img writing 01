% resize img
targetsize = [size(a,1), size(a,2)];

img1 = imresize(a, targetsize);
img2 = imresize(b, targetsize);
img1D = im2double(img1);
img2D = im2double(img2);
imgs = cell(6,1);
imgs{1} = imabsdiff(img1D, img2D);
imgs{2} = imsubtract(img1D, img2D);
imgs{3} = imadd(img1D, img2D);
imgs{4} = imcomplement(img1D);
imgs{5} = imdivide(img1D, img2D + eps);
imgs{6} = immultiply(img1D, img2D);

subplot(2,3,1);
imshow(imgs{1});
title('Absolute Difference');

subplot(2,3,2);
imshow(imgs{2});
title('Subtraction');

subplot(2,3,3);
imshow(imgs{3});
title('Addition');

subplot(2,3,4);
imshow(imgs{4});
title('Complement');

subplot(2,3,5);
imshow(imgs{5});
title('Division');

subplot(2,3,6);
imshow(imgs{6});
title('Multiplication');

