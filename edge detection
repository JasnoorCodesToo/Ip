clc;
clear;
close all;

% Read image
img = imread('solarspectra.tif');
img = im2gray(img);
img = im2double(img);

% Detect edges
E = edge(img, 'canny', 0.15);

% Hough Transform
[H, theta, rho] = hough(E);

% Find peaks
P = houghpeaks(H, 40);

% Detect lines
lines = houghlines(E, theta, rho, P, ...
    'FillGap', 20, 'MinLength', 30);

% Display images
figure;
subplot(1,3,1);
imshow(img);
title('Original Image');

subplot(1,3,2);
imshow(E);
title('Canny Edges');

subplot(1,3,3);
imshow(img);
title('Detected Lines');
hold on;

% Draw lines
for k = 1:length(lines)
    xy = [lines(k).point1; lines(k).point2];
    plot(xy(:,1), xy(:,2), 'r', 'LineWidth', 1.5);
end

hold off;
